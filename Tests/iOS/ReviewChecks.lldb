# Run after launching the iOS app with the debugger attached and interrupting it.
# These checks use only synthetic packets and temporary databases.
expression -l objc++ -- @import UIKit
expression -l objc++ -O -- ({ id w = [[NSClassFromString(@"CHRouter") shared] window]; (w && (id)[w windowScene] && (id)[w rootViewController]) ? @"PASS: scene-backed window and root controller" : @"FAIL: missing scene window"; })
expression -l objc++ -O -- ({ NSString *reviewMid = @"stale"; NSData *reviewPayload = [NSData new]; id result = [NSClassFromString(@"CHMessageModel") parsePacket:@{@"uid": @"review", @"msg": @42} mid:&reviewMid data:&reviewPayload]; (!result && !reviewMid && !reviewPayload) ? @"PASS: malformed packet rejected and outputs cleared" : @"FAIL: malformed packet"; })
expression -l objc++ -O -- ({ NSDictionary *packet = @{@"msg": @"production-packet", @"uid": @"review"}; [try_mock_notification(packet) isEqual:packet] ? @"PASS: simulator preserves production packets" : @"FAIL: simulator rewrote packet"; })
expression -l objc++ -O -- ({ NSDictionary *packet = @{@"aps": @{@"alert": @{@"text": [NSNull null]}}}; [try_mock_notification(packet) isEqual:packet] ? @"PASS: invalid mock field rejected safely" : @"FAIL: invalid mock"; })
expression -l objc++ -O -- ({ unsigned long long now = get_utc_time64(); double delta = (double)now / 1e9 - [[NSDate date] timeIntervalSince1970]; (delta > -0.1 && delta < 0.1 && now % 1000 == 0) ? @"PASS: nanosecond message timestamp" : @"FAIL: timestamp units"; })
expression -l objc++ -O -- ({ id ns = [NSClassFromString(@"CHNSDataSource") dataSourceWithURL:nil]; id db = [NSClassFromString(@"CHUserDataSource") dataSourceWithURL:nil]; NSData *reviewKey = [NSMutableData dataWithLength:64]; [ns updateKey:reviewKey uid:@"review"]; id content = (id)[NSClassFromString(@"CHTPMsgContent") new]; [content setValue:@1 forKey:@"type"]; [content setValue:@"review" forKey:@"text"]; id message = (id)[NSClassFromString(@"CHTPMessage") new]; [message setValue:(id)[content valueForKey:@"data"] forKey:@"content"]; NSData *sealed = [NSClassFromString(@"CHCrpyto") aesSealWithKey:[reviewKey subdataWithRange:NSMakeRange(0, 32)] data:(id)[message valueForKey:@"data"] nonce:[NSMutableData dataWithLength:12] auth:[reviewKey subdataWithRange:NSMakeRange(32, 32)]]; id first = [db upsertMessageData:sealed nsDB:ns uid:@"review" mid:@"0000000000000001" checker:^BOOL(NSString *cid) { return YES; } flags:nullptr]; NSInteger initial = (NSInteger)[db unreadSumAllChannel]; [db upsertMessageData:sealed nsDB:ns uid:@"review" mid:@"0000000000000001" checker:^BOOL(NSString *cid) { return YES; } flags:nullptr]; NSInteger duplicate = (NSInteger)[db unreadSumAllChannel]; [db upsertMessageData:sealed nsDB:ns uid:@"review" mid:@"0000000000000002" checker:^BOOL(NSString *cid) { return YES; } flags:nullptr]; NSInteger second = (NSInteger)[db unreadSumAllChannel]; id sqlQueue = (id)[db valueForKey:@"dbQueue"]; [sqlQueue inDatabase:^(id sql) { (BOOL)[sql executeStatements:@"CREATE TRIGGER reject_unread BEFORE UPDATE ON channels BEGIN SELECT RAISE(FAIL, 'review failure'); END;"]; }]; unsigned long failedFlags = 99; id failed = [db upsertMessageData:sealed nsDB:ns uid:@"review" mid:@"0000000000000003" checker:^BOOL(NSString *cid) { return YES; } flags:&failedFlags]; BOOL rolledBack = failed == nil && failedFlags == 0 && (id)[db messageWithMID:@"0000000000000003"] == nil && (NSInteger)[db unreadSumAllChannel] == 2; [sqlQueue inDatabase:^(id sql) { (BOOL)[sql executeStatements:@"DROP TRIGGER reject_unread;"]; }]; id retried = [db upsertMessageData:sealed nsDB:ns uid:@"review" mid:@"0000000000000003" checker:^BOOL(NSString *cid) { return YES; } flags:nullptr]; BOOL retryOK = retried != nil && (NSInteger)[db unreadSumAllChannel] == 3; id readDB = (id)[NSClassFromString(@"CHUserDataSource") dataSourceWithURL:nil]; [readDB upsertMessageData:sealed nsDB:ns uid:@"review" mid:@"0000000000000001" checker:^BOOL(NSString *cid) { return NO; } flags:nullptr]; BOOL readOK = (NSInteger)[readDB unreadSumAllChannel] == 0; [readDB close]; [ns upsertBlockedToken:@"review-token" uid:@"review"]; NSData *hash = (id)[[@"review-token" dataUsingEncoding:NSUTF8StringEncoding] sha1]; [message setValue:hash forKey:@"tokenHash"]; NSData *blockedData = [NSClassFromString(@"CHCrpyto") aesSealWithKey:[reviewKey subdataWithRange:NSMakeRange(0, 32)] data:(id)[message valueForKey:@"data"] nonce:[NSMutableData dataWithLength:12] auth:[reviewKey subdataWithRange:NSMakeRange(32, 32)]]; unsigned long discardedFlags = 0; id blocked = [db upsertMessageData:blockedData nsDB:ns uid:@"review" mid:@"0000000000000004" checker:^BOOL(NSString *cid) { return YES; } flags:&discardedFlags]; BOOL blockedOK = blocked == nil && (discardedFlags & 4) != 0 && (NSInteger)[db unreadSumAllChannel] == 3; [db close]; [ns close]; (first && initial == 1 && duplicate == 1 && second == 2 && rolledBack && retryOK && readOK && blockedOK) ? @"PASS: unread 1/1/2, rollback, retry, active-channel unread=0, blocklist" : [NSString stringWithFormat:@"FAIL: unread %ld/%ld/%ld", (long)initial, (long)duplicate, (long)second]; })
