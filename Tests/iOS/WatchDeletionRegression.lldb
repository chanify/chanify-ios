# Run in a fresh Watch Debug process after startup; interrupt first.
# The mock has no logged-in account and overrides all deletion I/O.
expression -l objc++ -- @import Foundation; @import ObjectiveC;
expression -l objc++ -O -- ({ NSMutableArray *watchReviewPurged = [NSMutableArray new]; NSMutableDictionary *watchReviewContext = [NSMutableDictionary new]; id watchReviewConfig = (id)[NSClassFromString(@"CHTPWatchConfig") new]; watchReviewContext[@"data"] = (id)[watchReviewConfig valueForKey:@"data"]; watchReviewContext[@"deletedAccounts"] = @[@"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", @"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", @"../invalid"]; Class watchReviewSessionClass = objc_allocateClassPair(NSObject.class, "CHWatchDeletionReviewSession", 0); class_addMethod(watchReviewSessionClass, @selector(receivedApplicationContext), imp_implementationWithBlock(^id(id obj) { return watchReviewContext; }), "@@:"); objc_registerClassPair(watchReviewSessionClass); Class watchReviewLogicClass = objc_allocateClassPair(NSClassFromString(@"CHLogic"), "CHWatchDeletionReviewLogic", 0); class_addMethod(watchReviewLogicClass, @selector(purgeLocalDataForUID:), imp_implementationWithBlock(^BOOL(id obj, NSString *uid) { [watchReviewPurged addObject:uid]; return YES; }), "B@:@"); objc_registerClassPair(watchReviewLogicClass); id watchReviewIsolated = class_createInstance(watchReviewLogicClass, 0); id watchReviewSession = (id)[watchReviewSessionClass new]; (void)[watchReviewIsolated updateContext:watchReviewSession]; BOOL watchReviewValid = watchReviewPurged.count == 2; (void)[watchReviewIsolated updateContext:watchReviewSession]; watchReviewValid && watchReviewPurged.count == 4 ? @"PASS: historical Watch deletions are applied and repeat safely; invalid paths ignored" : @"FAIL: Watch deletion history"; })
