expression -l objc++ -O -- ({ unsigned long flags = 999; id model = (id)[$watchFixNS pushMessage:$watchOuterSealed mid:@"0000000000000001" uid:@"synthetic-key-delay" flags:&flags]; (void)[$watchFixLogic setValue:@1 forKey:@"inboxGeneration"]; (void)[$watchFixLogic setValue:@YES forKey:@"processingInbox"]; (void)[$watchFixLogic drainWatchInboxAfterMID:@"" uid:@"synthetic-key-delay" dataSource:$watchFixDB generation:1]; __block NSInteger stored = -1; (void)[(id)[$watchFixDB valueForKey:@"dbQueue"] inDatabase:^(id sql) { stored = (NSInteger)[sql intForQuery:@"SELECT COUNT(*) FROM messages;"]; }]; __block NSUInteger remaining = 0; (void)[$watchFixNS enumerateWatchMessagesWithUID:@"synthetic-key-delay" afterMID:@"" limit:16 error:nullptr block:^(id sql, NSString *mid, NSData *data) { remaining++; }]; (void)[$watchFixLogic setValue:@2 forKey:@"inboxGeneration"]; (!model && flags == 4 && stored == 0 && remaining == 1) ? @"PASS: missing inner key retains inbox and never commits a placeholder" : @"FAIL: missing key handling"; })
expression -l objc++ -O -- ({ [$watchFixNS updateKey:$watchOuterKey uid:$watchNodeKeyID]; unsigned long flags = 999; NSData *raw = [NSData new]; id model = (id)[NSClassFromString(@"CHMessageModel") modelWithStorage:$watchFixNS uid:@"synthetic-key-delay" mid:@"0000000000000001" data:$watchOuterSealed raw:&raw flags:&flags]; (!model && !raw && flags == 0) ? @"PASS: wrong inner key clears stale output flags and does not produce a model" : @"FAIL: wrong key handling"; })
