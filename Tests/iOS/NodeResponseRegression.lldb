# The uninitialized CHLogicBase has a fake session; no real account, disk, Keychain or network.
# Phase: setup
expression -l objc++ -- @import UIKit; @import ObjectiveC;
expression -l objc++ -- NSMutableArray *$nodeResponseResults = [[NSMutableArray alloc] init]; id $nodeResponseLogic = (id)[NSClassFromString(@"CHLogicBase") alloc];
expression -l objc++ -O -- ({ Class task = objc_allocateClassPair(NSObject.class,"CHNodeResponseTask",0); class_addMethod(task,sel_registerName("resume"),imp_implementationWithBlock(^(id obj){}),"v@:"); objc_registerClassPair(task); Class session = objc_allocateClassPair(NSObject.class,"CHNodeResponseSession",0); class_addMethod(session,sel_registerName("dataTaskWithRequest:completionHandler:"),imp_implementationWithBlock(^id(id obj, NSURLRequest *request, void (^completion)(NSData *, NSURLResponse *, NSError *)) { NSData *nodeResponseBytes = (id)objc_getAssociatedObject(obj,sel_registerName("nodeResponsePayload")); NSHTTPURLResponse *response = [[NSHTTPURLResponse alloc] initWithURL:request.URL statusCode:200 HTTPVersion:@"HTTP/1.1" headerFields:@{}]; completion(nodeResponseBytes,response,nil); return class_createInstance(NSClassFromString(@"CHNodeResponseTask"),0); }),"@@:@@?"); objc_registerClassPair(session); (void)[$nodeResponseLogic setValue:class_createInstance(session,0) forKey:@"session"]; @"PASS: isolated response transport installed"; })
expression -l objc++ -- ({ NSMutableArray *nodeResponseChecks = $nodeResponseResults; for (NSString *body in @[@"[]", @"null", @"{\"key\":null}", @"{\"msg\":7}", @"{\"res\":[]}", @""]) { objc_setAssociatedObject((id)[$nodeResponseLogic valueForKey:@"session"],sel_registerName("nodeResponsePayload"),[body dataUsingEncoding:NSUTF8StringEncoding],OBJC_ASSOCIATION_RETAIN_NONATOMIC); (void)[$nodeResponseLogic sendToEndpoint:[NSURL URLWithString:@"https://invalid.example"] cmd:@"test" device:NO seckey:nil user:nil parameters:@{} completion:^(id response,id result,NSError *error){ [nodeResponseChecks addObject:@(result == nil && error != nil && NSThread.isMainThread)]; }]; } });
expression -l objc++ -- ({ NSMutableArray *nodeResponseChecks = $nodeResponseResults; objc_setAssociatedObject((id)[$nodeResponseLogic valueForKey:@"session"],sel_registerName("nodeResponsePayload"),[@"{\"res\":200,\"msg\":\"ok\",\"key\":\"a2V5\"}" dataUsingEncoding:NSUTF8StringEncoding],OBJC_ASSOCIATION_RETAIN_NONATOMIC); (void)[$nodeResponseLogic sendToEndpoint:[NSURL URLWithString:@"https://invalid.example"] cmd:@"test" device:NO seckey:nil user:nil parameters:@{} completion:^(id response,id result,NSError *error){ [nodeResponseChecks addObject:@(result != nil && error == nil && NSThread.isMainThread)]; }]; });
expression -l objc++ -- ({ NSMutableArray *nodeResponseChecks = $nodeResponseResults; for (NSString *body in @[@"[]", @"null", @"{\"nodeid\":null}", @"{\"version\":[]}", @"{\"features\":[null]}", @""]) { objc_setAssociatedObject((id)[$nodeResponseLogic valueForKey:@"session"],sel_registerName("nodeResponsePayload"),[body dataUsingEncoding:NSUTF8StringEncoding],OBJC_ASSOCIATION_RETAIN_NONATOMIC); (void)[$nodeResponseLogic loadNodeWitEndpoint:@"https://invalid.example" completion:^(int code,id result){ [nodeResponseChecks addObject:@(code == 500 && result == nil && NSThread.isMainThread)]; }]; } });
expression -l objc++ -- ({ NSMutableArray *nodeResponseChecks = $nodeResponseResults; (void)[$nodeResponseLogic loadNodeWitEndpoint:@"invalid" completion:^(int code,id result){ [nodeResponseChecks addObject:@(code == 500 && result == nil)]; }]; (void)[$nodeResponseLogic insertNode:(id)[NSClassFromString(@"CHNodeModel") modelWithNID:@"synthetic" name:@"Synthetic" version:@"1" endpoint:@"https://invalid.example" pubkey:nil flags:0 features:nil] completion:^(int code){ [nodeResponseChecks addObject:@(code == 500)]; }]; (void)[$nodeResponseLogic sendToEndpoint:nil cmd:@"test" device:NO seckey:nil user:nil parameters:@{} completion:^(id response,id result,NSError *error){ [nodeResponseChecks addObject:@(result == nil && error.code == -1000)]; }]; });
expression -l objc++ -- ({ NSMutableArray *nodeResponseChecks = $nodeResponseResults; id nodeResponseKey = (id)[[NSClassFromString(@"CHSecKey") alloc] init]; NSDictionary *nodeResponseInfo = @{@"nodeid":(id)[nodeResponseKey formatID:1], @"pubkey":(id)[(NSData *)[nodeResponseKey pubkey] base64Code], @"version":@"0", @"name":@"Synthetic", @"endpoint":@"https://invalid.example", @"features":@[@"platform.watchos"]}; objc_setAssociatedObject((id)[$nodeResponseLogic valueForKey:@"session"],sel_registerName("nodeResponsePayload"),[NSJSONSerialization dataWithJSONObject:nodeResponseInfo options:0 error:nil],OBJC_ASSOCIATION_RETAIN_NONATOMIC); (void)[$nodeResponseLogic loadNodeWitEndpoint:@"https://invalid.example" completion:^(int code,id result){ [nodeResponseChecks addObject:@(code == 200 && result != nil && NSThread.isMainThread)]; }]; });
# Phase: check
expression -l objc++ -O -- $nodeResponseResults.count == 17 && ![$nodeResponseResults containsObject:@NO] ? @"PASS: 17 malformed/valid responses, invalid URLs and logged-out binding; callbacks on main queue" : (id)$nodeResponseResults;
