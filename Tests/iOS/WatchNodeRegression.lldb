# Run in a fresh Watch Debug process after startup, then interrupt.
# Uses in-memory databases and an uninitialized test instance: no WC delegate,
# real account, Keychain, filesystem or network changes.
expression -l objc++ -- @import Foundation; @import ObjectiveC;
expression -l objc++ -O -- ({ Class watchNodeUserClass = objc_allocateClassPair(NSObject.class, "CHWatchNodeReviewUser", 0); class_addMethod(watchNodeUserClass, @selector(uid), imp_implementationWithBlock(^id(id obj) { return @"review-watch-node"; }), "@@:"); objc_registerClassPair(watchNodeUserClass); id watchNodeLogic = class_createInstance(NSClassFromString(@"CHLogic"), 0); id watchNodeDB = (id)[NSClassFromString(@"CHUserDataSource") dataSourceWithURL:nil]; id watchNodeNS = (id)[NSClassFromString(@"CHNSDataSource") dataSourceWithURL:nil]; (void)[watchNodeLogic setValue:watchNodeDB forKey:@"userDataSource"]; (void)[watchNodeLogic setValue:watchNodeNS forKey:@"nsDataSource"]; (void)[watchNodeLogic updateUserModel:(id)[watchNodeUserClass new]]; id watchRemovedNode = (id)[NSClassFromString(@"CHNodeModel") modelWithNID:@"removed-node" name:@"Removed" version:@"1" endpoint:@"https://invalid.example" pubkey:nil flags:0 features:nil]; id watchKeptNode = (id)[NSClassFromString(@"CHNodeModel") modelWithNID:@"kept-node" name:@"Kept" version:@"1" endpoint:@"https://invalid.example" pubkey:nil flags:0 features:nil]; NSData *watchNodeSecret = [NSMutableData dataWithLength:64]; (void)[watchNodeLogic setValue:[NSSet setWithArray:@[@"removed-node", @"kept-node"]] forKey:@"syncedNodeIDs"]; BOOL watchInserted = (BOOL)[watchNodeLogic insertNode:watchRemovedNode secret:watchNodeSecret] && (BOOL)[watchNodeLogic insertNode:watchKeptNode secret:watchNodeSecret]; (void)[watchNodeLogic setValue:[NSSet setWithObject:@"kept-node"] forKey:@"syncedNodeIDs"]; BOOL watchRemoved = (BOOL)[watchNodeLogic deleteNode:@"removed-node"]; BOOL watchLateWrite = (BOOL)[watchNodeLogic insertNode:watchRemovedNode secret:watchNodeSecret]; BOOL watchKeptWrite = (BOOL)[watchNodeLogic insertNode:watchKeptNode secret:watchNodeSecret]; NSArray *watchRemaining = (id)[watchNodeDB loadNodes]; BOOL watchOnlyKept = [[NSSet setWithArray:[watchRemaining valueForKey:@"nid"]] isEqualToSet:[NSSet setWithArray:@[@"sys", @"kept-node"]]]; (void)[watchNodeLogic close]; watchInserted && watchRemoved && !watchLateWrite && watchKeptWrite && watchOnlyKept ? @"PASS: removed Watch node cannot be revived by a late write; retained node still updates" : @"FAIL: Watch node removal regression"; })
