# Launch Chanify-iOS on an iPhone simulator with the debugger attached, then interrupt.
# These checks create a separate controller and do not change the user's account.
expression -l objc++ -- @import UIKit; @import WebKit; @import ObjectiveC;
expression -l objc++ -O -- ({ id vc = [NSClassFromString(@"CHPrivacyViewController") new]; objc_setAssociatedObject(UIApplication.sharedApplication, (void *)sel_registerName("privacyReview"), vc, OBJC_ASSOCIATION_RETAIN_NONATOMIC); [vc loadViewIfNeeded]; [((WKWebView *)[vc valueForKey:@"webView"]) stopLoading]; vc ? @"PASS: privacy controller loaded" : @"FAIL: run the iOS app, not Watch"; })
expression -l objc++ -O -- ({ NSObject *vc = (NSObject *)objc_getAssociatedObject(UIApplication.sharedApplication, (void *)sel_registerName("privacyReview")); WKWebView *web = [vc valueForKey:@"webView"]; [(id<WKNavigationDelegate>)vc webView:web didFailProvisionalNavigation:nil withError:[NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorCancelled userInfo:nil]]; vc && ![(NSNumber *)[vc valueForKey:@"showingOfflinePolicy"] boolValue] ? @"PASS: cancellation keeps current policy" : @"FAIL: cancellation"; })
expression -l objc++ -O -- ({ NSObject *vc = (NSObject *)objc_getAssociatedObject(UIApplication.sharedApplication, (void *)sel_registerName("privacyReview")); WKWebView *web = [vc valueForKey:@"webView"]; [(id<WKNavigationDelegate>)vc webView:web didFailProvisionalNavigation:nil withError:[NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorNotConnectedToInternet userInfo:nil]]; vc && [(NSNumber *)[vc valueForKey:@"showingOfflinePolicy"] boolValue] ? @"PASS: offline failure selects bundled policy" : @"FAIL: offline fallback"; })
# Continue, let WebKit finish loading, then interrupt and run the following check.
# expression -l objc++ -O -- ({ NSObject *vc = (NSObject *)objc_getAssociatedObject(UIApplication.sharedApplication, (void *)sel_registerName("privacyReview")); WKWebView *web = [vc valueForKey:@"webView"]; (web.URL.isFileURL && !web.loading && web.alpha > 0) ? @"PASS: bundled policy loaded and visible" : @"FAIL: bundled policy did not load"; })
# Cleanup after the checks:
# expression -l objc++ -- objc_setAssociatedObject(UIApplication.sharedApplication, (void *)sel_registerName("privacyReview"), nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC)
