# Launch iOS with LLDB, allow startup to finish, then interrupt before running.
# Use a fresh process. Completion blocks run on the main queue: after sourcing,
# continue, allow the main queue to drain, interrupt, and inspect reviewState.
# All accounts/keys below are mocks. No real Keychain, filesystem or server writes.
expression -l objc++ -- @import UIKit; @import Foundation; @import ObjectiveC;
expression -l objc++ -- ({ NSMutableDictionary *review = [NSMutableDictionary new]; Class keyClass = objc_allocateClassPair(NSObject.class, "CHDeletionReviewKeyV2", 0); class_addMethod(keyClass, @selector(deleteWithName:device:), imp_implementationWithBlock(^BOOL(id obj, NSString *name, BOOL device) { return ![(NSNumber *)review[@"failKey"] boolValue]; }), "B@:@B"); class_addMethod(keyClass, @selector(pubkey), imp_implementationWithBlock(^id(id obj) { return [NSData new]; }), "@@:"); class_addMethod(keyClass, @selector(decode:), imp_implementationWithBlock(^id(id obj, NSData *input) { return [NSMutableData dataWithLength:64]; }), "@@:@"); objc_registerClassPair(keyClass); id mockKey = (id)[keyClass new]; Class userClass = objc_allocateClassPair(NSObject.class, "CHDeletionReviewUserV2", 0); class_addMethod(userClass, @selector(uid), imp_implementationWithBlock(^id(id obj) { return objc_getAssociatedObject(obj, @selector(uid)); }), "@@:"); class_addMethod(userClass, @selector(key), imp_implementationWithBlock(^id(id obj) { return mockKey; }), "@@:"); objc_registerClassPair(userClass); id userA = (id)[userClass new]; id userB = (id)[userClass new]; objc_setAssociatedObject(userA, @selector(uid), @"review-deletion-a", OBJC_ASSOCIATION_RETAIN_NONATOMIC); objc_setAssociatedObject(userB, @selector(uid), @"review-deletion-b", OBJC_ASSOCIATION_RETAIN_NONATOMIC); review[@"userA"] = userA; review[@"userB"] = userB; Class logicClass = objc_allocateClassPair(NSClassFromString(@"CHLogicBase"), "CHDeletionReviewLogicV2", 0); class_addMethod(logicClass, @selector(purgeLocalDataForUID:), imp_implementationWithBlock(^BOOL(id obj, NSString *uid) { return YES; }), "B@:@"); class_addMethod(logicClass, @selector(doLogout), imp_implementationWithBlock(^(id obj) { (void)[obj updateUserModel:nil]; }), "v@:"); class_addMethod(logicClass, @selector(sendToEndpoint:cmd:device:seckey:user:parameters:completion:), imp_implementationWithBlock(^(id obj, id endpoint, id cmd, BOOL device, id mockCipher, id user, id params, id completion) { review[@"completion"] = (id)[completion copy]; }), "v@:@@B@@@@"); class_addMethod(logicClass, @selector(insertNode:secret:), imp_implementationWithBlock(^BOOL(id obj, id node, id secret) { review[@"inserted"] = @YES; return YES; }), "B@:@@"); class_addMethod(object_getClass(logicClass), @selector(reviewState), imp_implementationWithBlock(^id(id cls) { return review; }), "@@:"); objc_registerClassPair(logicClass); review[@"logic"] = (id)[logicClass new]; })
expression -l objc++ -O -- ({ NSMutableDictionary *review = (id)[NSClassFromString(@"CHDeletionReviewLogicV2") reviewState]; id logic = review[@"logic"]; (void)[logic updateUserModel:review[@"userA"]]; review[@"failKey"] = @YES; BOOL failed = !(BOOL)[logic deleteLocalAccountWithUID:@"review-deletion-a"]; BOOL pending = (BOOL)[logic isAccountDeletionPending:@"review-deletion-a"]; (void)[logic bindAccount:nil completion:^(int code) { review[@"blockedBind"] = @(code); }]; review[@"failKey"] = @NO; BOOL retried = (BOOL)[logic deleteLocalAccountWithUID:@"review-deletion-a"]; BOOL cleared = !(BOOL)[logic isAccountDeletionPending:@"review-deletion-a"] && (id)[logic me] == nil; review[@"recoverySync"] = @(failed && pending && retried && cleared); @"Scheduled: deletion recovery check"; })
expression -l objc++ -O -- ({ NSMutableDictionary *review = (id)[NSClassFromString(@"CHDeletionReviewLogicV2") reviewState]; id logic = review[@"logic"]; (void)[logic updateUserModel:review[@"userA"]]; id node = (id)[NSClassFromString(@"CHNodeModel") modelWithNID:@"review-node" name:@"Review" version:@"1" endpoint:@"https://invalid.example" pubkey:nil flags:0 features:nil]; (void)[logic insertNode:node completion:^(int code) { review[@"lateNode"] = @(code); }]; (void)[logic updateUserModel:review[@"userB"]]; void (^reply)(id,id,id) = review[@"completion"]; reply([[NSHTTPURLResponse alloc] initWithURL:[NSURL URLWithString:@"https://invalid.example"] statusCode:200 HTTPVersion:nil headerFields:nil], @{@"key":@""}, nil); review[@"noCrossAccountWrite"] = @(![(NSNumber *)review[@"inserted"] boolValue]); @"Scheduled: late node response check"; })
expression -l objc++ -O -- ({ NSMutableDictionary *review = (id)[NSClassFromString(@"CHDeletionReviewLogicV2") reviewState]; id logic = review[@"logic"]; (void)[logic updateUserModel:review[@"userA"]]; (void)[logic deleteAccount:review[@"userA"] nodes:@[] index:0 completion:^(int code) { review[@"malformedResponse"] = @(code); }]; void (^reply)(id,id,id) = review[@"completion"]; reply([[NSHTTPURLResponse alloc] initWithURL:[NSURL URLWithString:@"https://invalid.example"] statusCode:200 HTTPVersion:nil headerFields:nil], @{@"deleted":[NSNull null], @"uid":@42}, nil); review[@"keptAccount"] = @((id)[logic me] == review[@"userA"]); @"Scheduled: malformed deletion response check"; })
expression -l objc++ -O -- ({ NSMutableDictionary *review = (id)[NSClassFromString(@"CHDeletionReviewLogicV2") reviewState]; id reviewLogic = review[@"logic"]; (void)[reviewLogic updateUserModel:review[@"userA"]]; (void)[reviewLogic setAccountDeletionPending:YES uid:@"review-deletion-a"]; [review removeObjectForKey:@"completion"]; (void)[reviewLogic logoutWithCompletion:^(int code) { review[@"pendingLogout"] = @(code); }]; review[@"retryEntryKept"] = @((id)[reviewLogic me] == review[@"userA"] && (BOOL)[reviewLogic isAccountDeletionPending:@"review-deletion-a"] && review[@"completion"] == nil); (void)[reviewLogic setAccountDeletionPending:NO uid:@"review-deletion-a"]; (void)[reviewLogic logoutWithCompletion:^(int code) { review[@"normalLogout"] = @(code); }]; void (^reviewReply)(id,id,id) = review[@"completion"]; reviewReply([[NSHTTPURLResponse alloc] initWithURL:[NSURL URLWithString:@"https://invalid.example"] statusCode:200 HTTPVersion:nil headerFields:nil], @{}, nil); review[@"normalLogoutCleared"] = @((id)[reviewLogic me] == nil); @"Scheduled: pending deletion retains retry entry; ordinary logout still works"; })
# After resuming/draining/interruption, run:
# expression -l objc++ -O -- ({ NSDictionary *r = (id)[NSClassFromString(@"CHDeletionReviewLogicV2") reviewState]; [(NSNumber *)r[@"recoverySync"] boolValue] && [(NSNumber *)r[@"blockedBind"] intValue] == 500 && [(NSNumber *)r[@"lateNode"] intValue] == 500 && [(NSNumber *)r[@"noCrossAccountWrite"] boolValue] && [(NSNumber *)r[@"malformedResponse"] intValue] == 500 && [(NSNumber *)r[@"keptAccount"] boolValue] && [(NSNumber *)r[@"pendingLogout"] intValue] == 406 && [(NSNumber *)r[@"retryEntryKept"] boolValue] && [(NSNumber *)r[@"normalLogout"] intValue] == 200 && [(NSNumber *)r[@"normalLogoutCleared"] boolValue] ? @"PASS: deletion recovery, stale node callback and invalid response" : @"FAIL: deletion regression"; })
