# Isolated iOS asynchronous paging and forced-refresh regression.
# Run with the debugger attached in a clean simulator with no account.
# Import UIKit, then run each named phase in order. Resume between phases to let
# worker/main-queue callbacks run (allow ~3 seconds for indexing in search-start).
# Interrupt at an idle mach_msg run-loop frame, never inside malloc/Objective-C locks.
# Fixture objects use alloc/copy ownership because LLDB expressions do not retain
# autoreleased factory results across run-loop resumes. Stop the app after cleanup.
# This uses only synthetic messages and a temporary database, never an account key.

# Phase: setup
expression -l objc++ -- @import UIKit
expression -l objc++ --top-level -- @interface NSObject (CHSearchAsyncReview) + (id)dataSourceWithURL:(NSURL *)url; - (id)initWithURL:(NSURL *)url; - (void)close; - (BOOL)deleteMessage:(NSString *)mid; - (id)messageWithMID:(NSString *)mid; - (void)loadEarlistMessage; - (void)loadNextMessages; - (void)reset:(BOOL)animated; - (void)loadLatestMessage:(BOOL)animated; - (void)deleteMessage:(id)model animated:(BOOL)animated; - (void)retryTargetMessage:(id)sender; - (void)loadMessagesWithCID:(NSString *)cid from:(NSString *)from to:(NSString *)to count:(NSUInteger)count ascending:(BOOL)ascending completion:(void (^)(NSArray *, NSError *))completion; - (void)loadMessagesNearMID:(NSString *)mid channelID:(NSString *)cid count:(NSUInteger)count completion:(void (^)(NSArray *, NSError *))completion; @end
expression -l objc++ -- id $searchAsyncLogic = (id)[NSClassFromString(@"CHLogic") shared]; id $searchAsyncOriginalDB = (id)[$searchAsyncLogic valueForKey:@"userDataSource"]; NSURL *$searchAsyncURL = [[NSURL alloc] initFileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:[NSUUID.UUID.UUIDString stringByAppendingString:@".sqlite"]]]; id $searchAsyncDB = (id)[[NSClassFromString(@"CHUserDataSource") alloc] initWithURL:$searchAsyncURL]; NSMutableDictionary *$searchAsyncState = [NSMutableDictionary new]; NSString *$searchAsyncHex = @"";
expression -l objc++ -O -- ({ (void)[(id)[$searchAsyncDB valueForKey:@"messageSearch"] setActive:NO]; id asyncContent=(id)[NSClassFromString(@"CHTPMsgContent") new]; [asyncContent setValue:@1 forKey:@"type"]; [asyncContent setValue:@"连接失败 asynchronous regression" forKey:@"title"]; [asyncContent setValue:@"Synthetic message body for asynchronous paging and stale-result checks." forKey:@"text"]; id asyncPacket=(id)[NSClassFromString(@"CHTPMessage") new]; [asyncPacket setValue:(id)[asyncContent valueForKey:@"data"] forKey:@"content"]; NSData *asyncRaw=(id)[asyncPacket valueForKey:@"data"]; NSMutableString *asyncHex=[NSMutableString string]; const unsigned char *asyncBytes=(const unsigned char *)asyncRaw.bytes; for(NSUInteger i=0;i<asyncRaw.length;i++) [asyncHex appendFormat:@"%02x",asyncBytes[i]]; $searchAsyncHex=[asyncHex copy]; NSString *asyncSQLHex=asyncHex; id asyncQueue=(id)[$searchAsyncDB valueForKey:@"dbQueue"]; __block BOOL asyncInserted=YES; [asyncQueue inDatabase:^(id sql){ for(int i=1;i<=200;i++) asyncInserted=(BOOL)[sql executeStatements:[NSString stringWithFormat:@"INSERT INTO messages(mid,cid,[from],raw) VALUES('%016x',X'0801','regression',X'%@');",i,asyncSQLHex]] && asyncInserted; }]; asyncInserted ? @"PASS: temporary synthetic source fixture" : @"FAIL: fixture"; })
expression -l objc++ -- NSMutableDictionary *asyncLoadState=$searchAsyncState; (void)[$searchAsyncDB loadMessagesWithCID:@"CAE" from:@"0000000000000032" to:@"" count:5 ascending:NO completion:^(NSArray *items, NSError *error){ asyncLoadState[@"older"] = @(!error && items.count==5 && [(NSString *)[(NSObject *)items.firstObject valueForKey:@"mid"] isEqualToString:@"0000000000000031"] && [(NSString *)[(NSObject *)items.lastObject valueForKey:@"mid"] isEqualToString:@"000000000000002d"] && NSThread.isMainThread); }]; (void)[$searchAsyncDB loadMessagesWithCID:@"CAE" from:@"7FFFFFFFFFFFFFFF" to:@"0000000000000032" count:5 ascending:YES completion:^(NSArray *items, NSError *error){ asyncLoadState[@"newer"] = @(!error && items.count==5 && [(NSString *)[(NSObject *)items.firstObject valueForKey:@"mid"] isEqualToString:@"0000000000000037"] && [(NSString *)[(NSObject *)items.lastObject valueForKey:@"mid"] isEqualToString:@"0000000000000033"] && NSThread.isMainThread); }]; (void)[$searchAsyncDB loadMessagesNearMID:@"0000000000000032" channelID:@"CAE" count:5 completion:^(NSArray *items, NSError *error){ asyncLoadState[@"context"] = @(!error && items.count==10 && NSThread.isMainThread); }];

# Phase: source-check
expression -l objc++ -O -- ([(NSNumber *)$searchAsyncState[@"older"] boolValue] && [(NSNumber *)$searchAsyncState[@"newer"] boolValue] && [(NSNumber *)$searchAsyncState[@"context"] boolValue]) ? @"PASS: asynchronous older/newer/context queries and main-thread completions" : (id)$searchAsyncState
expression -l objc++ -- NSMutableDictionary *asyncErrorState=$searchAsyncState; (void)[(id)[$searchAsyncDB valueForKey:@"dbQueue"] inDatabase:^(id sql){ (BOOL)[sql executeStatements:@"ALTER TABLE messages RENAME TO messages_unavailable;"]; }]; (void)[$searchAsyncDB loadMessagesWithCID:@"CAE" from:@"7FFFFFFFFFFFFFFF" to:@"" count:5 ascending:NO completion:^(NSArray *items, NSError *error){ asyncErrorState[@"error"] = @(error!=nil && items.count==0 && NSThread.isMainThread); }];

# Phase: error-check
expression -l objc++ -O -- [(NSNumber *)$searchAsyncState[@"error"] boolValue] ? @"PASS: read errors are reported, not mistaken for end of history" : @"FAIL: read error callback"
expression -l objc++ -- (void)[$searchAsyncLogic setValue:$searchAsyncDB forKey:@"userDataSource"]; UIViewController *$searchAsyncController = (id)[[NSClassFromString(@"CHChannelViewController") alloc] initWithParameters:@{@"cid":@"CAE",@"mid":@"0000000000000064"}]; (void)[$searchAsyncController view];

# Phase: target-error-check
expression -l objc++ -O -- ({ id asyncFailedData=(id)[$searchAsyncController valueForKey:@"dataSource"]; UICollectionView *asyncFailedList=(id)[$searchAsyncController valueForKey:@"listView"]; [(NSString *)(id)[asyncFailedData valueForKey:@"targetMID"] isEqualToString:@"0000000000000064"] && [asyncFailedList.backgroundView isKindOfClass:UIButton.class] ? @"PASS: a failed context read offers retry without declaring the message deleted" : @"FAIL: target error state"; })
expression -l objc++ -- (void)[(id)[$searchAsyncDB valueForKey:@"dbQueue"] inDatabase:^(id sql){ (BOOL)[sql executeStatements:@"ALTER TABLE messages_unavailable RENAME TO messages;"]; }]; (void)[(id)[$searchAsyncController valueForKey:@"dataSource"] retryTargetMessage:nil];

# Phase: context-check
expression -l objc++ -- id $searchAsyncData = (id)[$searchAsyncController valueForKey:@"dataSource"];
expression -l objc++ -O -- ({ NSArray *asyncCells=(id)[(id)[$searchAsyncData snapshot] itemIdentifiers]; BOOL asyncFound=NO; for(NSObject *cell in asyncCells) if([(NSString *)[cell valueForKey:@"mid"] isEqualToString:@"0000000000000064"]) asyncFound=YES; asyncFound ? @"PASS: async message focus" : @"FAIL: focus"; })
expression -l objc++ -- (void)[$searchAsyncData loadNextMessages]; (void)[$searchAsyncData loadEarlistMessage];

# Phase: paging-check
expression -l objc++ -O -- ({ NSArray *asyncCells=(id)[(id)[$searchAsyncData snapshot] itemIdentifiers]; NSMutableSet *asyncMessages=[NSMutableSet new]; NSUInteger asyncCount=0; for(NSObject *cell in asyncCells) { if([cell isKindOfClass:NSClassFromString(@"CHDateCellConfiguration")]) continue; asyncCount++; [asyncMessages addObject:[cell valueForKey:@"mid"]]; } BOOL asyncOK=asyncCount==asyncMessages.count && [asyncMessages containsObject:@"0000000000000045"] && [asyncMessages containsObject:@"0000000000000084"]; asyncOK ? @"PASS: adjacent pages are continuous and duplicate-free" : [NSString stringWithFormat:@"FAIL: paging count=%lu",(unsigned long)asyncCount]; })
# Phase: race-start
expression -l objc++ -- NSString *$searchAsyncRaceMID=@""; NSString *$searchAsyncRaceNeighbor=@"";
expression -l objc++ -O -- ({ NSArray *asyncBeforeCells=(id)[(id)[$searchAsyncData snapshot] itemIdentifiers]; NSString *asyncBeforeMID=(id)[(NSObject *)asyncBeforeCells.firstObject valueForKey:@"mid"]; unsigned long long asyncFloor=0; [[NSScanner scannerWithString:asyncBeforeMID] scanHexLongLong:&asyncFloor]; $searchAsyncRaceMID=[[NSString stringWithFormat:@"%016llx",asyncFloor-1] copy]; $searchAsyncRaceNeighbor=[[NSString stringWithFormat:@"%016llx",asyncFloor-2] copy]; id asyncRaceModel=(id)[$searchAsyncDB messageWithMID:$searchAsyncRaceMID]; (void)[$searchAsyncData loadEarlistMessage]; BOOL asyncRaceDeleted=(BOOL)[$searchAsyncDB deleteMessage:$searchAsyncRaceMID]; (void)[$searchAsyncData deleteMessage:asyncRaceModel animated:NO]; asyncFloor>2 && asyncRaceModel && asyncRaceDeleted ? @"PASS: delete during an outstanding page read" : @"FAIL: race fixture"; })

# Phase: race-check
expression -l objc++ -O -- ({ NSArray *asyncRaceCells=(id)[(id)[$searchAsyncData snapshot] itemIdentifiers]; NSMutableSet *asyncRaceMIDs=[NSMutableSet new]; NSUInteger asyncRaceCount=0; for(NSObject *cell in asyncRaceCells) if(![cell isKindOfClass:NSClassFromString(@"CHDateCellConfiguration")]) { [asyncRaceMIDs addObject:[cell valueForKey:@"mid"]]; asyncRaceCount++; } ![asyncRaceMIDs containsObject:$searchAsyncRaceMID] && [asyncRaceMIDs containsObject:$searchAsyncRaceNeighbor] && asyncRaceMIDs.count==asyncRaceCount ? @"PASS: deletion during paging does not resurrect or duplicate messages" : [NSString stringWithFormat:@"FAIL: race count=%lu deleted=%d neighbor=%d",(unsigned long)asyncRaceCount,[asyncRaceMIDs containsObject:$searchAsyncRaceMID],[asyncRaceMIDs containsObject:$searchAsyncRaceNeighbor]]; })
expression -l objc++ -- (void)[$searchAsyncData loadNextMessages]; (void)[$searchAsyncData reset:NO];

# Phase: reset-check
expression -l objc++ -O -- ({ NSArray *asyncCells=(id)[(id)[$searchAsyncData snapshot] itemIdentifiers]; BOOL asyncHasOld=NO; for(NSObject *cell in asyncCells) if([(NSString *)[cell valueForKey:@"mid"] isEqualToString:@"0000000000000064"]) asyncHasOld=YES; NSString *asyncLast=(id)[(NSObject *)asyncCells.lastObject valueForKey:@"mid"]; !asyncHasOld && [asyncLast isEqualToString:@"00000000000000c8"] ? @"PASS: reset rejects stale paging completion" : @"FAIL: reset generation"; })
expression -l objc++ -- NSString *asyncBurstHex=$searchAsyncHex; (void)[$searchAsyncData loadLatestMessage:NO]; (void)[(id)[$searchAsyncDB valueForKey:@"dbQueue"] inDatabase:^(id sql){ for(int i=201;i<=240;i++) (BOOL)[sql executeStatements:[NSString stringWithFormat:@"INSERT INTO messages(mid,cid,[from],raw) VALUES('%016x',X'0801','regression',X'%@');",i,asyncBurstHex]]; }]; (void)[$searchAsyncData loadLatestMessage:NO];

# Phase: burst-check
expression -l objc++ -O -- ({ NSArray *asyncCells=(id)[(id)[$searchAsyncData snapshot] itemIdentifiers]; NSMutableSet *asyncMIDs=[NSMutableSet new]; for(NSObject *cell in asyncCells) if(![cell isKindOfClass:NSClassFromString(@"CHDateCellConfiguration")]) [asyncMIDs addObject:[cell valueForKey:@"mid"]]; BOOL asyncAll=YES; for(int i=201;i<=240;i++) asyncAll=asyncAll && [asyncMIDs containsObject:[NSString stringWithFormat:@"%016x",i]]; asyncAll ? @"PASS: new-message bursts have no paging gaps" : @"FAIL: burst catch-up"; })
expression -l objc++ -- (void)[(id)[$searchAsyncDB valueForKey:@"messageSearch"] setActive:YES]; UITableViewController *$searchAsyncResults = (id)[[NSClassFromString(@"CHMessageSearchResultsController") alloc] initWithStyle:UITableViewStylePlain]; (void)[$searchAsyncResults updateQuery:@"连接"];

# Phase: search-start
expression -l objc++ -- (void)[$searchAsyncResults updateQuery:@"连接" force:YES];

# Phase: delete-start
expression -l objc++ -O -- ({ NSArray *asyncResults=(id)[$searchAsyncResults valueForKey:@"items"]; asyncResults.count>0 ? @"PASS: search results loaded" : @"FAIL: search results"; })
expression -l objc++ -- (void)[(id)[$searchAsyncDB valueForKey:@"messageSearch"] setActive:NO]; NSDictionary *asyncDeleteFirst = [(NSArray *)(id)[$searchAsyncResults valueForKey:@"items"] firstObject]; NSString *$searchAsyncDeletedMID = [(NSString *)[asyncDeleteFirst objectForKey:@"mid"] copy]; NSUInteger $searchAsyncRevision = [(NSNumber *)(id)[$searchAsyncResults valueForKey:@"revision"] unsignedIntegerValue]; (void)[$searchAsyncResults updateQuery:@"连接"];
expression -l objc++ -O -- [(NSNumber *)(id)[$searchAsyncResults valueForKey:@"revision"] unsignedIntegerValue] == $searchAsyncRevision ? @"PASS: unchanged query preserves results" : @"FAIL: same-query optimization"
expression -l objc++ -- (BOOL)[$searchAsyncDB deleteMessage:$searchAsyncDeletedMID]; (void)[$searchAsyncResults tableView:$searchAsyncResults.tableView didSelectRowAtIndexPath:[NSIndexPath indexPathForRow:0 inSection:0]];
expression -l objc++ -O -- [(NSNumber *)(id)[$searchAsyncResults valueForKey:@"revision"] unsignedIntegerValue] > $searchAsyncRevision ? @"PASS: deleted-message selection forces a fresh query" : @"FAIL: force refresh"

# Phase: delete-check
expression -l objc++ -O -- ({ NSArray *asyncResults=(id)[$searchAsyncResults valueForKey:@"items"]; BOOL asyncDeletedPresent=NO; for(NSDictionary *item in asyncResults) if([(NSString *)item[@"mid"] isEqualToString:$searchAsyncDeletedMID]) asyncDeletedPresent=YES; asyncResults.count>0 && !asyncDeletedPresent ? @"PASS: deleted result disappears while FTS cleanup is paused" : @"FAIL: stale search result"; })
expression -l objc++ -- (void)[$searchAsyncLogic setValue:$searchAsyncOriginalDB forKey:@"userDataSource"];
expression -l objc++ -- (void)[$searchAsyncDB close];
expression -l objc++ -O -- [(NSNumber *)(id)[$searchAsyncDB valueForKey:@"closed"] boolValue] ? @"PASS: fixture closed" : @"FAIL: fixture close"
# Stop the process after this phase. The disposable database is in the simulator's tmp directory.
