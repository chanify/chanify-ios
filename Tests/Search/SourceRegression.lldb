expression -l objc++ -O -- ({ id searchSourceDB = (id)[NSClassFromString(@"CHUserDataSource") dataSourceWithURL:nil]; id searchSourceQueue = [searchSourceDB valueForKey:@"dbQueue"]; id searchContent = (id) [NSClassFromString(@"CHTPMsgContent") new]; [searchContent setValue:@1 forKey:@"type"]; [searchContent setValue:@"Search regression title" forKey:@"title"]; [searchContent setValue:@"连接失败 regression body" forKey:@"text"]; id searchPacket = (id) [NSClassFromString(@"CHTPMessage") new]; [searchPacket setValue:(id)[searchContent valueForKey:@"data"] forKey:@"content"]; NSData *searchRaw = (id)[searchPacket valueForKey:@"data"]; NSMutableString *searchHex = [NSMutableString string]; const unsigned char *searchBytes = (const unsigned char *)searchRaw.bytes; for(NSUInteger i=0;i<searchRaw.length;i++) [searchHex appendFormat:@"%02x",searchBytes[i]]; [searchSourceQueue inDatabase:^(id sql) { for (int i=1; i<=100; i++) { (BOOL)[sql executeStatements:[NSString stringWithFormat:@"INSERT INTO messages(mid,cid,[from],raw) VALUES('%016x',X'0801','regression',X'%@');",i,searchHex]]; } }]; NSArray *searchNear = (id)[searchSourceDB messagesNearMID:@"0000000000000032" channelID:@"CAE" count:5]; NSArray *searchAfter = (id)[searchSourceDB messagesAfterMID:@"0000000000000032" channelID:@"CAE" count:5]; BOOL searchContextOK = searchNear.count == 10 && [(NSString *)[(NSObject *)searchNear.firstObject valueForKey:@"mid"] isEqualToString:@"0000000000000037"] && [(NSString *)[(NSObject *)searchNear.lastObject valueForKey:@"mid"] isEqualToString:@"000000000000002e"] && searchAfter.count == 5 && [(NSString *)[(NSObject *)searchAfter.lastObject valueForKey:@"mid"] isEqualToString:@"0000000000000033"]; [searchSourceQueue inDatabase:^(id sql) { (BOOL)[sql executeStatements:@"CREATE TRIGGER reject_search_delete BEFORE DELETE ON messages BEGIN SELECT RAISE(ABORT,'delete failure'); END;"]; }]; BOOL searchDeleteFailureOK = !(BOOL)[searchSourceDB deleteMessage:@"0000000000000032"] && !(BOOL)[searchSourceDB deleteMessages:@[@"0000000000000032",@"0000000000000033"]] && !(BOOL)[searchSourceDB deleteMessagesWithCID:@"CAE"] && (id)[searchSourceDB messageWithMID:@"0000000000000032"] != nil; [searchSourceQueue inDatabase:^(id sql) { (BOOL)[sql executeStatements:@"DROP TRIGGER reject_search_delete;"]; }]; BOOL searchDeleteOK = (BOOL)[searchSourceDB deleteMessages:@[@"0000000000000032",@"0000000000000033"]] && (id)[searchSourceDB messageWithMID:@"0000000000000032"] == nil; [searchSourceDB close]; searchContextOK && searchDeleteFailureOK && searchDeleteOK ? @"PASS: source context/forward pagination and delete failure rollback" : [NSString stringWithFormat:@"FAIL: context=%d deleteFailure=%d delete=%d near=%lu after=%lu",searchContextOK,searchDeleteFailureOK,searchDeleteOK,(unsigned long)searchNear.count,(unsigned long)searchAfter.count]; })
